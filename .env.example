
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

USE_LOCAL_DB=
LOCAL_DB_NAME=boutique_crm
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=5432

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# Customer try-on link sent with a finished garment's photos (TryOn2Buy).
TRYON_API_KEY=

# Emailed about every new boutique sign-up (comma-separated). Empty: nobody.
SIGNUP_ALERT_EMAILS=

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=



# Master switch for outgoing WhatsApp, for the whole platform. Off means nothing is
# sent, including sign-in codes and alerts; each boutique also has its own switch in
# Settings > WhatsApp integration, which cannot override this one.
WHATSAPP_SENDING_ENABLED=true

# Shared with whatsapp_service and set to the same value there. Required in
# production: that service will not start on the development default.
# INTERNAL_API_SECRET=
